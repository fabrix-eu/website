{
  "name": "fabrix-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.js",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "directus:bootstrap": "node --env-file-if-exists=.env scripts/directus-bootstrap.js",
    "directus:permissions": "node --env-file-if-exists=.env scripts/directus-permissions.js",
    "directus:migrate": "node --env-file-if-exists=.env scripts/directus-migrate.js",
    "directus:flow": "node --env-file-if-exists=.env scripts/directus-flow.js",
    "directus:newsletter-flow": "node --env-file-if-exists=.env scripts/directus-newsletter-flow.js"
  },
  "dependencies": {
    "@directus/sdk": "^20.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.4",
    "lucide-react": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "marked": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
