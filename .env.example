# Public Directus instance, shared with the Learning Hub. No token in the bundle: the Public role reads published content.
VITE_DIRECTUS_URL=https://back.fabrixproject.eu

# Scripts only (never prefixed VITE_). A static token on an admin user in Directus.
DIRECTUS_TOKEN=

# One-shot migration only: read-only DatoCMS API token of the old site.
DATOCMS_TOKEN=
DATOCMS_ENVIRONMENT=main
